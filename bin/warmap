#!/usr/bin/env python3
"""Run warmap straight from a checkout, without installing it.

    bin/warmap              open the map window
    bin/warmap --help       every subcommand

`pip install .` gives you the same thing as a `warmap` command on your PATH.
"""

import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO))

from warmap.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
